# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model (optional, default: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Max tokens per response (optional, default: 1024)
MAX_TOKENS=1024

# Log file path (optional, default: /var/log/tg-bot/bot.log)
LOG_FILE=/var/log/tg-bot/bot.log
